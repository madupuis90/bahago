{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); TOOL=$(jq -r '.tool_name' <<< \"$INPUT\"); CMD=$(jq -r '.tool_input.command // empty' <<< \"$INPUT\"); if [ \"$TOOL\" = \"Bash\" ] && [ -n \"$CMD\" ]; then W=$(awk '{print $1}' <<< \"$CMD\"); jq -n --arg w \"$W\" '{\"systemMessage\": (\"→ Add to allow-list: Bash(\" + $w + \" *)\")}'; fi"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(task *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(jq *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(diff *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(env)",
      "Bash(printenv *)",
      "Read(/workspaces/bahago/**)",
      "Read(//home/vscode/.claude/**)",
      "Read(//tmp/**)",
      "mcp__ide__getDiagnostics"
    ]
  }
}
