{
  "name": "bahago",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "containerEnv": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "postCreateCommand": "mkdir -p ~/.claude && echo '{\"theme\":\"dark\",\"autoCompactEnabled\":true,\"autoCompactWindow\":100000,\"autoMemoryDirectory\":\"/workspaces/bahago/.claude/memory\"}' > ~/.claude/settings.json",
  "features": {
    "ghcr.io/devcontainers-extra/features/go-task:1": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "task.vscode-task"
      ],
      "settings": {
        "sqltools.connections": [
          {
            "name": "Container PostgreSQL DB",
            "driver": "PostgreSQL",
            "server": "db", // From docker-compose.yaml
            "port": 5432,
            "database": "appdb",
            "username": "postgres",
            "password": "postgres"
          }
        ]
      }
    }
  }
}